{
  "name": "mira-broadcast-studio",
  "productName": "MİRA Broadcast Studio",
  "version": "1.0.0",
  "description": "MLBB 5-Hero Kick & TikTok Live Studio Stream Deck & OBS Overlays",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "app": "electron .",
    "server": "node server.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "pack:win": "electron-builder --win --dir",
    "pack:linux": "electron-builder --linux --dir"
  },
  "build": {
    "appId": "com.mira.broadcaststudio",
    "productName": "MİRA Broadcast Studio",
    "copyright": "Copyright © 2026 MİRA Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "kick/**/*",
      "tiktok/**/*",
      "shared/**/*",
      "index.html",
      "custom-overlay.html",
      "floating-chat.html",
      "stream-stats.json",
      "tts-config.json",
      "user-gallery.json",
      "default-user-gallery.json",
      "main.js",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MİRA Broadcast Studio"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    }
  },
  "keywords": [
    "mira",
    "broadcast-studio",
    "stream-deck",
    "mlbb",
    "obs",
    "kick",
    "tiktok"
  ],
  "author": "Cihan Ataş <cihanatas@mira.studio>",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "obs-websocket-js": "^5.0.8",
    "pusher-js": "^8.6.0",
    "tiktok-live-connector": "^2.5.0"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
